# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# You can use a local MongoDB (e.g. mongodb://localhost:27017/service_booking)
# or a free MongoDB Atlas connection string: mongodb+srv://<user>:<password>@cluster0.mongodb.net/service_booking
# If left blank or unreachable in development, the server will automatically spin up an embedded in-memory MongoDB!
MONGODB_URI=mongodb://localhost:27017/service_booking

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_service_booking_app_2026_dev_secure
JWT_EXPIRES_IN=7d

# AI Assistant Configuration
# Get a free Gemini API key at: https://aistudio.google.com/
# If left empty, the server automatically uses the built-in intelligent rule-based AI assistant!
GEMINI_API_KEY=

# CORS Configuration
# Set to * to allow all origins (Flutter Web, Android Emulator 10.0.2.2, iOS Simulator localhost, physical devices)
CORS_ORIGIN=*

