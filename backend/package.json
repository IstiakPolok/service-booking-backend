{
  "name": "service-booking-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Production-grade REST API backend with AI Assistant for Service Booking & Management Flutter Application",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node \"./node_modules/tsx/dist/cli.mjs\" watch src/server.ts",
    "build": "node \"./node_modules/typescript/bin/tsc\" && node --input-type=module -e \"import fs from 'fs'; fs.mkdirSync('dist/swagger', {recursive: true}); fs.copyFileSync('src/swagger/swagger.json', 'dist/swagger/swagger.json');\"",
    "start": "node dist/server.js",
    "seed": "node \"./node_modules/tsx/dist/cli.mjs\" src/scripts/seed.ts",
    "lint": "node \"./node_modules/typescript/bin/tsc\" --noEmit"
  },
  "keywords": [
    "flutter",
    "backend",
    "express",
    "typescript",
    "mongodb",
    "jwt",
    "ai",
    "gemini",
    "rest-api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.1",
    "morgan": "^1.10.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.4",
    "@types/swagger-ui-express": "^4.1.7",
    "mongodb-memory-server": "^10.1.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
